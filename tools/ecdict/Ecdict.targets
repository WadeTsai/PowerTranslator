<Project>
  <!--
    Bundles the offline ECDICT (English -> Traditional Chinese) dictionary.

    data/ecdict.bin is generated by tools/ecdict/build_ecdict.py (it downloads ECDICT and
    converts it to Traditional Chinese with OpenCC) and is not committed to git. When the file
    is missing, the build tries to generate it once; set -p:SkipEcdictBuild=true to opt out.
    Without the data the extension still works, but only with English definitions and DeepL.
  -->
  <PropertyGroup>
    <EcdictRepoRoot>$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory), '..', '..'))</EcdictRepoRoot>
    <EcdictDataFile>$(EcdictRepoRoot)data$([System.IO.Path]::DirectorySeparatorChar)ecdict.bin</EcdictDataFile>
    <EcdictBuildScript>$(MSBuildThisFileDirectory)build_ecdict.py</EcdictBuildScript>
    <EcdictPython Condition="'$(EcdictPython)' == '' and '$(OS)' == 'Windows_NT'">python</EcdictPython>
    <EcdictPython Condition="'$(EcdictPython)' == ''">python3</EcdictPython>
  </PropertyGroup>

  <Target Name="EnsureEcdictData"
          BeforeTargets="AssignTargetPaths;BeforeBuild"
          Condition="!Exists('$(EcdictDataFile)') and '$(SkipEcdictBuild)' != 'true'">
    <Message Importance="high" Text="ECDICT data not found, generating $(EcdictDataFile) ..." />
    <Exec Command="&quot;$(EcdictPython)&quot; &quot;$(EcdictBuildScript)&quot; --out &quot;$(EcdictDataFile)&quot;"
          WorkingDirectory="$(EcdictRepoRoot)"
          ContinueOnError="true" />
    <Warning Condition="!Exists('$(EcdictDataFile)')"
             Text="ECDICT data could not be generated. Run 'pip install opencc' and 'python tools/ecdict/build_ecdict.py' (or 'just ecdict'). The package will be built without the offline dictionary." />
    <ItemGroup Condition="Exists('$(EcdictDataFile)')">
      <Content Include="$(EcdictDataFile)" Link="Data\ecdict.bin" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="Exists('$(EcdictDataFile)')">
    <Content Include="$(EcdictDataFile)" Link="Data\ecdict.bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
