# 讓 git 把這些副檔名當二進位處理：不做換行符轉換、不試圖 diff 文本
# 防止 PNG 等圖片被某些工具按 UTF-8 文本讀取後寫回時損壞（曾發生過：
# 模板自帶的 Asset PNG 在初次 commit 時被破壞，所有非 ASCII 位元組被替換
# 成 U+FFFD，檔案不可恢復）。

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.webp  binary
*.tif   binary
*.tiff  binary

*.msix       binary
*.msixbundle binary
*.msixupload binary
*.appx       binary
*.appxbundle binary
*.appxupload binary

*.zip binary
*.7z  binary
*.pdf binary

*.ttf binary
*.otf binary
*.woff  binary
*.woff2 binary

*.dll binary
*.exe binary
*.pdb binary

# 文本檔案強制 LF，避免 Windows 上 CRLF 汙染（與 PowerToys/cmdpal 倉庫習慣一致）
*.cs       text eol=lf
*.csproj   text eol=lf
*.sln      text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.ps1      text eol=lf

# Windows 指令碼保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
